+    { files: [{ name: "../summary.pdf" }] },
+    { files: [{ name: "summary.pdf", note: 2 }] },
+    { files: [{ name: "summary.pdf", note: "x".repeat(ARTIFACT_LIMITS.note + 1) }] },
+    { files: [{ name: "summary.pdf", links: "made-from" }] },
