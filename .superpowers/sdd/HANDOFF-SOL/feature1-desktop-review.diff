+/* ============================================================
+   FILES — one bounded index across every readable room.
+
+   The index is a studio archive drawer, not a second card system:
+   a compact docket opens the existing artifact card on the right.
+   The three-sheet version stamp is the one signature mark, because
+   immutable layers are the defining fact of this screen.
+   ============================================================ */
+.files-topbar{gap:12px;}
+.files-checked{
+  font-family:var(--mono);font-size:10.5px;color:var(--ink-3);white-space:nowrap;
+}
+.files-body{
+  flex:1;min-height:0;display:grid;grid-template-columns:minmax(292px,338px) minmax(0,1fr);
+  overflow:hidden;min-width:0;
+}
+.files-index{
+  min-width:0;min-height:0;display:flex;flex-direction:column;
+  background:var(--bg-2);border-right:1px solid var(--line);overflow:hidden;
+}
+.files-index-head{
+  flex:none;display:flex;align-items:center;gap:9px;padding:17px 16px 11px;min-width:0;
+}
+.files-index-head .eyebrow{flex:1;min-width:0;}
+.files-list{flex:1;min-height:0;overflow-y:auto;padding:0 10px 12px;}
+.files-state{
+  margin:4px 3px;padding:18px 15px;border:1.5px dashed var(--line);border-radius:var(--radius);
+  background:var(--surface-2);color:var(--ink-2);display:flex;flex-direction:column;
+  align-items:flex-start;gap:6px;font-size:12.5px;line-height:1.5;
+}
+.files-state>b{font-family:var(--display);font-size:15px;color:var(--ink);}
+.files-state.is-error{border-color:color-mix(in srgb,var(--madder) 42%,transparent);background:var(--madder-soft);}
+.files-state.is-error>b{color:var(--madder);}
+.files-empty-mark{
+  width:42px;height:42px;display:grid;place-items:center;border-radius:var(--radius-s);
+  background:var(--surface);border:1px solid var(--line);color:var(--ink-3);
+  font-family:var(--mono);font-size:9px;letter-spacing:.08em;
+}
+.file-index-row{
+  width:100%;display:grid;grid-template-columns:38px minmax(0,1fr) auto;gap:10px;
+  align-items:center;text-align:left;padding:10px 9px;margin-bottom:5px;min-width:0;
+  border:1px solid transparent;border-radius:var(--radius-s);color:var(--ink);
+  transition:background .14s var(--ease),border-color .14s var(--ease),transform .12s var(--ease);
+}
+.file-index-row:active{transform:translateY(1px);}
+.file-index-row[aria-current="true"]{
+  background:var(--surface);border-color:var(--line);box-shadow:var(--shadow);
+}
+.file-index-glyph{
+  width:38px;height:38px;display:grid;place-items:center;border-radius:var(--radius-xs);flex:none;
+  background:var(--pine-soft);color:var(--pine);border:1px solid color-mix(in srgb,var(--pine) 25%,transparent);
+  font-family:var(--mono);font-size:9.5px;font-weight:600;letter-spacing:.06em;
+}
+.file-index-copy{min-width:0;display:flex;flex-direction:column;gap:2px;}
+.file-index-name{
+  font-family:var(--display);font-size:14.5px;font-weight:600;line-height:1.2;
+  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
+}
+.file-index-room{font-size:11.5px;color:var(--ultra);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
+.file-index-maker{
+  display:flex;align-items:baseline;gap:6px;min-width:0;color:var(--ink-2);font-size:11.5px;
+  overflow:hidden;white-space:nowrap;
+}
+.file-index-maker code{
+  min-width:0;overflow:hidden;text-overflow:ellipsis;font-family:var(--mono);font-size:9.5px;color:var(--ink-3);
+}
+.file-index-date{font-family:var(--mono);font-size:9.5px;color:var(--ink-3);white-space:nowrap;}
+.file-index-facts{display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex:none;}
+/* Three slightly offset sheets: a file version is a layer, never an overwritten row. */
+.versionstack{
+  position:relative;z-index:0;min-width:34px;height:25px;display:grid;place-items:center;
+  padding:0 5px 0 7px;border:1px solid var(--line);border-radius:5px;background:var(--surface);
+  font-family:var(--mono);font-size:9.5px;color:var(--pine);font-weight:600;
+}
+.versionstack i{position:absolute;inset:2px -3px -3px 2px;border:1px solid var(--line);border-radius:5px;z-index:-1;}
+.versionstack i:nth-child(2){inset:4px -5px -5px 4px;opacity:.7;}
+.accessmark{
+  font-family:var(--mono);font-size:8.5px;letter-spacing:.07em;text-transform:uppercase;
+  color:var(--ink-3);white-space:nowrap;
+}
+.accessmark.restricted{color:var(--marigold);}
+.files-page-foot{flex:none;padding:10px 13px 14px;border-top:1px solid var(--line-soft);}
+.files-more{width:100%;}
+.files-end{display:block;font-size:11.5px;line-height:1.5;color:var(--ink-3);text-align:center;}
+
+.files-detail{min-width:0;min-height:0;overflow-y:auto;background:var(--bg);}
+.files-detail-inner{width:min(100%,1040px);padding:26px 30px 60px;display:flex;flex-direction:column;gap:16px;}
+.files-detail-empty{
+  min-height:100%;display:grid;place-content:center;justify-items:center;text-align:center;
+  gap:8px;padding:36px;color:var(--ink-2);
+}
+.files-detail-empty h3{font-size:22px;color:var(--ink);}
+.files-detail-empty p{max-width:42ch;font-size:13.5px;}
+.files-detail-mark{
+  width:50px;height:50px;display:grid;place-items:center;border:1px solid var(--line);
+  border-radius:var(--radius);background:var(--surface);color:var(--ink-3);box-shadow:var(--shadow);
+  font-family:var(--mono);font-size:18px;
+}
+.filedetail-head{display:flex;align-items:flex-start;gap:16px;min-width:0;flex-wrap:wrap;}
+.filedetail-title{flex:1;min-width:min(100%,280px);display:flex;flex-direction:column;gap:4px;}
+.filedetail-title h3{font-size:28px;line-height:1.08;overflow-wrap:anywhere;}
+.filedetail-title p{font-size:12px;color:var(--ink-3);font-family:var(--mono);}
+.filedetail-actions{display:flex;justify-content:flex-end;gap:7px;flex-wrap:wrap;max-width:100%;}
+.filerefcopy{max-width:100%;}
+/* The detail IS the existing artifact card, enlarged but behaviorally identical. */
+.artcard.place-workspace{padding:14px 15px;border-radius:var(--radius);box-shadow:var(--shadow);}
+.artcard.place-workspace .glyph{width:48px;height:48px;font-size:10px;}
+.artcard.place-workspace .artname{font-size:17px;}
+.artcard.place-workspace .artmain{align-items:flex-start;}
+.artcard.place-workspace .act{padding-top:5px;}
+.filedetail-sec{margin:0;min-width:0;}
+.filedetail-sec>.eyebrow{display:block;margin-bottom:10px;}
+.filedetail-wait,.filedetail-empty,.filedetail-note{font-size:12.5px;line-height:1.55;color:var(--ink-3);}
+.relationlist{display:flex;flex-direction:column;gap:7px;}
+.relationrow{
+  display:grid;grid-template-columns:104px minmax(0,1fr);gap:12px;align-items:center;
+  min-width:0;padding:8px 10px;border:1px solid var(--line-soft);border-radius:var(--radius-s);
+  background:var(--surface-2);
+}
+.relationlead{display:flex;flex-direction:column;gap:1px;min-width:0;}
+.relationkind{font-family:var(--mono);font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-3);}
+.relationhere{font-family:var(--mono);font-size:9px;color:var(--ink-3);white-space:nowrap;}
+.relationtarget{
+  min-width:0;display:flex;align-items:center;gap:9px;text-align:left;color:var(--ultra);
+  padding:2px 0;border-bottom:1px solid transparent;
+}
+.relationtarget:hover{border-bottom-color:var(--ultra);}
+.relationname{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600;}
+.relationversion{flex:none;font-family:var(--mono);font-size:10px;color:var(--ink-3);}
+.relationhidden{font-size:12.5px;color:var(--ink-3);font-style:italic;}
+
+.accesssummary{display:flex;flex-direction:column;gap:4px;font-size:12.5px;line-height:1.55;color:var(--ink-2);}
+.accesssummary b{font-family:var(--display);font-size:15px;color:var(--ink);}
+.accesssummary+.filedetail-note{margin-top:8px;}
+.accesseditor{display:flex;flex-direction:column;gap:12px;}
+.accesschoices{display:grid;grid-template-columns:1fr 1fr;gap:9px;}
+.accesschoice{
+  min-width:0;display:grid;grid-template-columns:auto minmax(0,1fr);gap:9px;text-align:left;
+  padding:11px 12px;border:1px solid var(--line);border-radius:var(--radius-s);background:var(--surface-2);
+}
+.accesschoice:hover{border-color:var(--ink-3);}
+.accesschoice[aria-pressed="true"]{border-color:var(--pine);background:var(--pine-soft);}
+.accesschoice .tick{color:var(--ink-3);font-family:var(--mono);}
+.accesschoice[aria-pressed="true"] .tick{color:var(--pine);}
+.accesschoice>span:last-child{display:flex;flex-direction:column;gap:2px;min-width:0;}
+.accesschoice b{font-size:13px;color:var(--ink);}
+.accesschoice em{font-style:normal;font-size:11.5px;line-height:1.45;color:var(--ink-3);}
+.accesspeople{
+  display:flex;flex-direction:column;gap:6px;padding:11px;border:1px solid var(--line-soft);
+  border-radius:var(--radius-s);background:var(--surface-2);max-height:300px;overflow-y:auto;
+}
+.accessperson{
+  display:flex;align-items:center;gap:9px;min-width:0;padding:7px 9px;border:1px solid var(--line);
+  border-radius:var(--radius-s);background:var(--surface);font-size:12.5px;cursor:pointer;
+}
+.accessperson:has(input:checked){border-color:color-mix(in srgb,var(--pine) 42%,var(--line));background:var(--pine-soft);}
+.accessperson.required{cursor:default;}
+.accessperson input{accent-color:var(--pine);flex:none;}
+.accessperson-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
+.accessperson .chip{font-size:9px;padding:2px 7px;}
+.accessactions{display:flex;align-items:center;gap:9px;flex-wrap:wrap;}
+.fileaccess-problem{margin:0;}
+
+@media (max-width:1120px){
+  .files-body{grid-template-columns:minmax(260px,310px) minmax(0,1fr);}
+  .files-detail-inner{padding-left:22px;padding-right:22px;}
+  .filedetail-actions{justify-content:flex-start;}
+  .accesschoices{grid-template-columns:minmax(0,1fr);}
+}
+@media (max-width:860px){
+  .files-topbar{height:auto;min-height:var(--top-h);padding-top:9px;padding-bottom:9px;flex-wrap:wrap;}
+  .files-topbar .sub{order:3;flex-basis:100%;}
+  .files-checked{display:none;}
+  .files-body{grid-template-columns:minmax(0,1fr);grid-template-rows:minmax(190px,38vh) minmax(0,1fr);}
+  .files-index{border-right:0;border-bottom:1px solid var(--line);}
+  .files-index-head{padding-top:11px;padding-bottom:8px;}
+  .files-detail-inner{width:100%;padding:18px 16px 44px;}
+  .filedetail-title h3{font-size:23px;}
+  .relationrow{grid-template-columns:minmax(0,1fr);gap:4px;}
+}
+@media (max-width:560px){
+  .file-index-row{grid-template-columns:34px minmax(0,1fr);}
+  .file-index-glyph{width:34px;height:34px;}
+  .file-index-facts{grid-column:2;flex-direction:row;align-items:center;justify-content:flex-start;}
+  .filedetail-actions{width:100%;justify-content:flex-start;}
+  .filedetail-actions .btn{white-space:normal;text-align:center;}
+  .artcard.place-workspace .artmain{flex-wrap:wrap;}
+  .artcard.place-workspace .act{margin-left:59px;padding-top:0;}
+  .accessperson{flex-wrap:wrap;}
+}
