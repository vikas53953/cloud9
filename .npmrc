# Refuse to install on a Node this project cannot run on, instead of warning and
# carrying on. Without this, Node 20 installs "fine" and every relay test then
# fails as ERR_UNKNOWN_BUILTIN_MODULE (node:sqlite arrived in Node 22) — a
# silent not-green. The floor lives in the "engines" field of each package.json.
# This applies to `npx` as well as `npm install`: inside this repo, running a
# tool whose own engines range excludes your Node fails with EBADENGINE rather
# than running. Nothing is blocked today — none of the installed packages has
# an upper bound that excludes a supported Node. Emergency bypass, if a
# dependency or a tool ever declares a stale range:
#   npm install --engine-strict=false
#   npx --engine-strict=false <tool>
# GitHub Actions themselves are unaffected — `actions/checkout` and
# `actions/setup-node` do not install through this file.
engine-strict=true
