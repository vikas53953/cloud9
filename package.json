{
  "name": "cloud9",
  "private": true,
  "version": "0.1.0",
  "description": "Cloud9 — chat with your crew of agents and friends, everywhere.",
  "workspaces": [
    "packages/*",
    "apps/relay",
    "apps/desktop"
  ],
  "scripts": {
