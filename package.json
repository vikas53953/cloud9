    "test": "npm test -w @cloud9/engine -w @cloud9/relay",
    "dev:relay": "npm run dev -w @cloud9/relay"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "typescript": "^5.6.0"
  }
}
